{
  "name": "thecornerworld",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:weather": "node scripts/build-weather.mjs",
    "build:pages": "node scripts/build-pages.mjs && node scripts/stamp.mjs",
    "build:version": "node scripts/stamp.mjs",
    "check": "node scripts/check.mjs && node scripts/test-globe.mjs",
    "accounts": "node scripts/accounts.mjs",
    "lock": "node scripts/lock.mjs",
    "db:start": "supabase start -x studio,postgres-meta,imgproxy,vector,logflare,realtime,storage-api,edge-runtime,mailpit,supavisor",
    "db:stop": "supabase stop",
    "test:db": "supabase test db",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory docs",
    "serve:phone": "python3 -m http.server 8000 --directory docs",
    "rate": "node scripts/rate.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.0",
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
