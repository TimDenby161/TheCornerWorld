<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Corner World on ASP.NET Core (phase 1a of the family stack): serves the site in ../../docs
       as it is, behind TheCorner.Web's security core. docs/ stays the one copy of the pages; a publish
       copies it into wwwroot. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../lib/TheCorner.Web/src/TheCorner.Web/TheCorner.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <DocsFiles Include="../../docs/**/*" Exclude="../../docs/CNAME;../../docs/.nojekyll" />
  </ItemGroup>
  <Target Name="CopyDocsOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(DocsFiles)" DestinationFiles="@(DocsFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
